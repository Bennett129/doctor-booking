# Copy to .env.local. Everything is optional for local development.

# Postgres connection string (Neon). Leave unset to use a local PGlite database
# (stored in the system temp folder, or in PGLITE_DIR if set).
DATABASE_URL=

# Resend API key. Leave unset to print emails to the server console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Riverside Family Practice <onboarding@resend.dev>"

# Where booking notifications for the doctor are sent
DOCTOR_EMAIL=doctor@example.com

# Admin login. Defaults to "admin" in development; required in production.
ADMIN_PASSWORD=
# Long random string used to sign cookies; required in production.
SESSION_SECRET=

# IANA timezone the clinic operates in
CLINIC_TIMEZONE=Europe/London

# Public URL of the site, used for links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
